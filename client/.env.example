# Client Environment Configuration Example
# Leave empty or omit when deploying behind a single-origin reverse proxy (recommended).
# The client will use relative URLs ('/api' and current window.location for Socket.IO).

# Optional: Override API base URL if hosting frontend and backend on separate domains
# VITE_API_URL=https://api.yourdomain.com

# Optional: Override Socket.IO server URL if hosting frontend and backend on separate domains
# VITE_SOCKET_URL=https://api.yourdomain.com
